    "start": "node src/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@inquirer/input": "^5.2.1",
    "@inquirer/select": "^5.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "ultracite": "^8.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}
