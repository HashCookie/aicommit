{
  "name": "unique-aicommit",
  "version": "1.0.38",
  "description": "A tool to generate standardized commit messages using AI.",
  "keywords": [
    "AI",
    "commit",
    "git",
    "automation",
    "conventional-commits"
  ],
  "homepage": "https://github.com/HashCookie/aicommit#readme",
  "bugs": {
    "url": "https://github.com/HashCookie/aicommit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HashCookie/aicommit.git"
  },
  "license": "ISC",
  "author": "HashCookie",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "aicommit": "src/index.js"
  },
  "files": [
    "src/index.js",
    "src/config.js",
    "src/git.js",
    "src/providers.js",
    "src/prompt.js"
  ],
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepublishOnly": "npm run check && npm test",
